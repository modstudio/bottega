{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "plugins": ["./hub/web/lint/layout-only-classname.grit"],
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!hub/web/src/routeTree.gen.ts",
      "!!**/migrations/meta",
      "!!**/dist",
      "!!orchestrator/runs"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "auto"
          }
        },
        "noNonNullAssertion": "off",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "conventions": [
              { "selector": { "kind": "typeLike" }, "formats": ["PascalCase"] },
              { "selector": { "kind": "enumMember" }, "formats": ["PascalCase", "CONSTANT_CASE"] },
              { "selector": { "kind": "function" }, "formats": ["camelCase", "PascalCase"] },
              { "selector": { "kind": "classMethod" }, "formats": ["camelCase"] },
              { "selector": { "kind": "classGetter" }, "formats": ["camelCase"] },
              { "selector": { "kind": "classSetter" }, "formats": ["camelCase"] },
              { "selector": { "kind": "functionParameter" }, "formats": ["camelCase"] },
              { "selector": { "kind": "catchParameter" }, "formats": ["camelCase"] },
              {
                "selector": { "kind": "variable" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": { "kind": "importAlias" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": { "kind": "exportAlias" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              { "selector": { "kind": "typeParameter" }, "formats": ["PascalCase"] },
              {
                "selector": { "kind": "objectLiteralProperty" },
                "match": ".*"
              },
              {
                "selector": { "kind": "classProperty" },
                "match": ".*"
              },
              {
                "selector": { "kind": "typeProperty" },
                "match": ".*"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": { "maxLines": 80, "skipBlankLines": true }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["hub/ui/**", "hub/views/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": { "filenameCases": ["kebab-case"] }
            },
            "noDefaultExport": "error"
          },
          "performance": {
            "noBarrelFile": "error",
            "noReExportAll": "error"
          }
        }
      }
    },
    {
      "includes": [
        "hub/ui/**/*.stories.tsx",
        "hub/ui/.storybook/*.ts",
        "hub/ui/.storybook/*.tsx",
        "hub/ui/vitest.config.ts",
        "hub/views/**/*.stories.tsx",
        "hub/views/.storybook/*.ts",
        "hub/views/.storybook/*.tsx",
        "hub/views/vitest.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "off",
              "options": { "maxLines": 65535, "skipBlankLines": true }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
