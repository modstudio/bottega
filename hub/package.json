{
  "name": "@bottega/hub",
  "version": "0.1.0",
  "private": true,
  "description": "One aggregator: tasks in flight across every project, what each cost, and scheduled reports",
  "type": "module",
  "scripts": {
    "evidence:mcp-dialects": "bun --no-env-file scripts/mcp-dialect-evidence.ts",
    "hub": "bun --no-env-file src/cli.ts",
    "report-deliver": "bun src/report-delivery-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns 'data/**'",
    "test:postgres": "bun scripts/test-postgres-evidence.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1135.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@trpc/server": "^11.17.0",
    "commander": "15.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@trpc/client": "^11.17.0",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
