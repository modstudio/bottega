<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.hub-send</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/bin/hub</string>
        <string>send</string>
    </array>

    <!-- A calendar job, unlike the collector: this fires once a day, so paying
         bun's startup for it costs nothing and a resident process would be
         asleep for 23 hours and 59 minutes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>

    <!-- PATH is not inherited under launchd, and the send shells `orch` for its
         summaries and `curl` to deliver. `security` needs /usr/bin for the
         keychain lookup. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>__STATE_HOME_ENV__</key>
        <string>__STATE_HOME__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/hub/send.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/hub/send.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
