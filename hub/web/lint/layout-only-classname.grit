language js

// A ui/ component takes layout classes only (margin, size, flex and grid
// placement); its appearance comes from its own variants. The list names every
// component exported from hub/web/src/ui; add a component here when it lands.
// Grit binds regex groups, so every group here is non-capturing.
or {
  JsxOpeningElement(name=$element, attributes=$attributes),
  JsxSelfClosingElement(name=$element, attributes=$attributes)
} where {
  $element <: r"(?:Badge|Identifier|Button|IconButton|Input|Textarea|Checkbox|Switch|Spinner|Kbd|Separator|Popover|Tooltip|Menu|Select|Dialog|Toaster|Pagination|AppShell|UserMenu|TableCard|ToolbarBand|Segmented)",
  $attributes <: some JsxAttribute(name=$name, initializer=$value) as $attribute where {
    $name <: `className`,
    $value <: r"[\s\S]*[^a-z-](?:bg|text|border|rounded|shadow|font|ring|outline|opacity|leading|tracking|p|px|py|pt|pr|pb|pl|ps|pe|fill|stroke|decoration|underline)(?:-|[^a-z-])[\s\S]*"
  },
  register_diagnostic(span=$attribute, message="Pass only layout classes to a component (margin, size, flex and grid placement); change its appearance through a variant.")
}
