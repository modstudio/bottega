{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(*orch result *)",
      "Bash(*orch diff *)",
      "Bash(*orch inbox*)",
      "Bash(*orch runs*)",
      "Bash(*orch pending*)",
      "Bash(*orch wait *)",
      "Bash(*orch jobs*)",
      "Bash(*orch guide*)",
      "Bash(*orch pick *)",
      "Bash(*orch contract *)",
      "Bash(*orch search *)",
      "Bash(*orch spawns*)",
      "Bash(*orch project list*)",
      "Bash(*orch doc list*)",
      "Bash(*orch land --status*)",
      "Bash(*orch monitor --history*)",
      "Bash(*hub task list*)",
      "Bash(*hub task show *)",
      "Bash(bun run check)",
      "mcp__starship__query-database-tool",
      "mcp__starship__get-task-tool",
      "mcp__starship__get-workflow-step-tool",
      "mcp__alephbeis__query-database-tool",
      "mcp__alephbeis__get-workflow-step-tool",
      "mcp__adanim__workflow_step",
      "mcp__orch__list_projects",
      "mcp__orch__list_docs",
      "mcp__orch__get_doc",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_find",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "Bash(*orch run *)",
      "Bash(*orch stats*)",
      "Bash(*orch doctor*)",
      "Bash(*orch monitor*)",
      "Bash(*orch agents*)",
      "Bash(*orch doc show *)",
      "Bash(*orch doc history *)",
      "Bash(*orch review calibration *)",
      "Bash(*hub task doc list *)",
      "Bash(*hub task doc show *)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(*orch score *)",
      "Bash(*orch do *)",
      "Bash(*orch continue *)",
      "Bash(*orch answer *)",
      "Bash(*orch review record *)",
      "Bash(*orch review triage *)",
      "Bash(*orch review complete *)",
      "Bash(*orch discard *)",
      "Bash(*orch land *)",
      "Bash(*hub task comment *)",
      "Bash(*hub task close *)",
      "Bash(*hub task new *)",
      "Bash(*hub task set *)",
      "Bash(git push origin main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file \"$CLAUDE_PROJECT_DIR/orchestrator/hooks/canon-edit-guard.ts\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file \"$CLAUDE_PROJECT_DIR/orchestrator/hooks/canon-edit-guard.ts\" compact",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
