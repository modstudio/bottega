#!/bin/sh
set -eu
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
main_checkout=${BOTTEGA_MAIN_CHECKOUT:-$(dirname "$common_dir")}
git_dir=$(git rev-parse --git-dir)
harness_marker="$git_dir/bottega-harness-run"
if [ -f "$harness_marker" ]; then
  run_id=$(cat "$harness_marker")
  echo "pre-push: harness run $run_id refused: a harness run's tree never pushes" >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  case "$remote_ref" in
    refs/tags/*) continue ;;
    refs/heads/*) ;;
    *) continue ;;
  esac
  if [ ! -x "$main_checkout/bin/bottega" ]; then
    echo "pre-push: triage check could not run: $main_checkout/bin/bottega is missing or not executable; allowing push" >&2
    continue
  fi
  if ! command -v bun >/dev/null 2>&1; then
    echo "pre-push: triage check could not run: bun is unavailable; allowing push" >&2
    continue
  fi
  "$main_checkout/bin/bottega" pr check --local-ref "$local_ref" --sha "$local_sha" --remote-ref "$remote_ref"
done
