#!/bin/sh
# Refuse a commit message that credits an AI. The Claude Code hook catches this
# earlier for tool-driven commits; this is the backstop for everything else.
# Refuse a subject with no DEV-<digits> task key (merge/fixup/squash exempt).
# Both checks always run so one cannot mask the other.
status=0

if grep -qiE 'co-authored-by:.*(claude|anthropic)|generated (with|by) \[?claude code|claude-session:|claude\.ai/code/session_|generated by (an )?ai\b' "$1"; then
  echo "commit-msg: AI attribution is not allowed in commit messages" >&2
  status=1
fi

subject=$(sed -n '1p' "$1")
case "$subject" in
Merge\ *|fixup!*|squash!*) ;;
*)
  if ! printf '%s\n' "$subject" | grep -qE 'DEV-[0-9]+'; then
    echo "commit-msg: subject must contain a DEV-<digits> task key" >&2
    echo "commit-msg: hub task new --project bottega --title \"...\"" >&2
    status=1
  fi
  ;;
esac

exit "$status"
