#!/bin/sh

# A linked worktree shares the main checkout's hooksPath. Only the main
# checkout owns the long-lived stores and installed dependencies.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
[ "$git_dir" = "$common_dir" ] || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
git rev-parse --verify ORIG_HEAD >/dev/null 2>&1 || exit 0
changed=$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null) || exit 0
[ -n "$changed" ] || exit 0

case "$changed" in
  *"orchestrator/migrations/"*|orchestrator/migrations/*|*"hub/migrations/"*|hub/migrations/*)
    # A caller may carry the live-store override used by linked worktrees.
    # The main checkout migrates the stores resolved by its own binaries.
    unset BOTTEGA_ORCHESTRATOR_DB BOTTEGA_DEPTH
    (cd "$root" && ./bin/bottega machine migrate)
    migrate_status=$?
    if [ "$migrate_status" -eq 75 ]; then
      echo "post-merge: migration left for the update drain. Use './bin/bottega machine update' instead of git pull so runs can be answered or stopped before the old code moves. If the store is already behind and the named lease holders cannot finish, run: ./bin/bottega machine migrate --force-in-flight \"<reason>\" --from-operator. Checkout: $root" >&2
    elif [ "$migrate_status" -ne 0 ]; then
      echo "post-merge: migration failed; run by hand: cd '$root' && ./bin/bottega machine migrate" >&2
    fi
    ;;
esac

if printf '%s\n' "$changed" | grep -Eq '(^|/)package\.json$'; then
  if ! (cd "$root" && bun install --silent); then
    echo "post-merge: package install failed; run by hand: cd '$root' && bun install --silent" >&2
  fi
fi

# The merge is already complete. Diagnostics above describe recovery, but a
# post-merge failure cannot undo it and must not make git report that it could.
exit 0
