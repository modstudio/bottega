<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.orch-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CHECKOUT__/bin/orch</string>
        <string>monitor</string>
        <string>--backstop</string>
    </array>

    <!-- Provisional four-hour backstop. The installer owns the named constant
         and its evidence; monitor_invocation and monitor_condition record the
         observations that will replace this first value. -->
    <key>StartInterval</key>
    <integer>__MONITOR_BACKSTOP_SECONDS__</integer>

    <key>WorkingDirectory</key>
    <string>__CHECKOUT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>__STATE_HOME_ENV__</key>
        <string>__STATE_HOME__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/orch-monitor/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/orch-monitor/launchd.log</string>
</dict>
</plist>
