<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.hub-tunnel</string>
  <!-- Publishes the local dashboard at its public hostname through Cloudflare
       Tunnel. Cloudflare Access in front of that hostname is the only login;
       the dashboard itself authenticates nobody. The config and the tunnel
       credentials live in ~/.cloudflared, which cloudflared owns; install.sh
       skips this agent when the config is absent. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--no-autoupdate</string>
    <string>--config</string><string>__HOME__/.cloudflared/hub-tunnel.yml</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- cloudflared exits at once without a network; without this launchd would
       respawn it in a tight loop. -->
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/hub-tunnel/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/hub-tunnel/launchd.err.log</string>
</dict>
</plist>
