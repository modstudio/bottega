<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.orch-canon-eval</string>

    <!-- Behavioral canon evals: known-answer probes against the current pack.

         DAILY, after the morning refresh has settled. These are --probe runs
         and never routing evidence. The command skips an eval whose canon_sha
         still matches the last pass for that agent unless invoked with --force. -->
    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_ROOT__/bin/orch</string>
        <string>canon</string>
        <string>eval</string>
    </array>

    <!-- 07:00: after brew (06:00) and the morning refresh (06:30), so four
         probe runs do not contend with those jobs. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>__INSTALL_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>__STATE_HOME_ENV__</key>
        <string>__STATE_HOME__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/orch-canon-eval/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/orch-canon-eval/launchd.log</string>
</dict>
</plist>
