<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.record-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__FLYCTL__</string>
    <string>proxy</string>
    <string>__RECORD_TUNNEL_LOCAL_PORT__:__RECORD_TUNNEL_REMOTE_PORT__</string>
    <string>-a</string>
    <string>__RECORD_TUNNEL_APP__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/record-tunnel/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/record-tunnel/launchd.err.log</string>
</dict>
</plist>
