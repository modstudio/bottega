<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.orch-record-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>&quot;__BOTTEGA_BIN__&quot; record push
push_status=$?
&quot;__BOTTEGA_BIN__&quot; record publish
publish_status=$?
if [ "$push_status" -ne 0 ] || [ "$publish_status" -ne 0 ]; then exit 1; fi</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>WorkingDirectory</key><string>__HOME__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>__STATE_HOME_ENV__</key><string>__STATE_HOME__</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/orch-record-sync/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/orch-record-sync/launchd.log</string>
</dict>
</plist>
