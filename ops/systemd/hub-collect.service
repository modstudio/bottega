[Unit]
Description=Bottega record collector

[Service]
Type=simple
ExecStart="__BOTTEGA_BIN__" record pull --watch
Restart=always
RestartSec=10
Environment="PATH=/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin"
Environment="HOME=__HOME__"
Environment="__STATE_HOME_ENV__=__STATE_HOME__"
WorkingDirectory=%h

[Install]
WantedBy=default.target
