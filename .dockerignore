# The record API image is built from the repository root. Only what the server
# runs from is sent; local stores, run files, checkouts and git never are.
*
!package.json
!bun.lock
!tsconfig.base.json
!shared/
!orchestrator/package.json
!orchestrator/tsconfig.json
!orchestrator/src/
!orchestrator/deploy/backup/
!hub/package.json
!hub/tsconfig.json
!hub/src/
!hub/web/package.json
!hub/web/tsconfig.json
!hub/web/vite.config.ts
!hub/web/index.html
!hub/web/src/
**/*.test.ts
**/*.test.tsx
**/node_modules
