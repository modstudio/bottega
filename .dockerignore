# The record API image is built from the repository root. Only what the server
# runs from is sent; local stores, run files, checkouts and git never are.
*
!package.json
!bun.lock
!tsconfig.base.json
!shared/
!orchestrator/package.json
!orchestrator/tsconfig.json
!orchestrator/src/
!orchestrator/deploy/backup/
!hub/package.json
!hub/tsconfig.json
!hub/src/
!hub/web/package.json
# A workspace member's manifest, needed by the frozen install even though the
# image never runs its code.
!cli/package.json
!retrieval/package.json
!hub/deploy/site/package.json
!hub/data/package.json
!hub/ui/package.json
!hub/util/package.json
!hub/views/package.json
!hub/ui/tsconfig.json
# The web build imports the shared UI, views, data and util workspaces directly.
!hub/ui/src/
!hub/views/tsconfig.json
!hub/views/src/
!hub/data/tsconfig.json
!hub/data/src/
!hub/util/tsconfig.json
!hub/util/src/
!hub/web/tsconfig.json
!hub/web/vite.config.ts
!hub/web/index.html
# Root static files the page links to, such as the favicon.
!hub/web/public/
!hub/web/src/
**/*.test.ts
**/*.test.tsx
**/node_modules
