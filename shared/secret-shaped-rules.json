{
  "rules": [
    {
      "name": "authorization",
      "kind": "span",
      "pattern": "\\b(?:Proxy-)?Authorization\\s*[:=]\\s*\\S+[^\\r\\n]*",
      "ignoreCase": true
    },
    {
      "name": "bearer",
      "kind": "span",
      "pattern": "\\bBearer\\s+\\S+",
      "ignoreCase": true
    },
    {
      "name": "assignment",
      "kind": "span",
      "pattern": "(?<![A-Za-z0-9])(?:[A-Za-z0-9]+[_-])*(?:token|key|secret|password)\\s*[:=]\\s*\\S+",
      "ignoreCase": true
    },
    {
      "name": "provider-prefix",
      "kind": "span",
      "pattern": "(?<![A-Za-z0-9])(?:ghp_|gho_|ghu_|ghs_|ghr_|github_pat_|sk-|xox[bposa]-|AKIA)\\S*",
      "ignoreCase": false
    },
    {
      "name": "hex-run",
      "kind": "span",
      "pattern": "[0-9a-fA-F]{32,}",
      "ignoreCase": false
    },
    {
      "name": "url-userinfo",
      "kind": "span",
      "pattern": "[a-zA-Z][a-zA-Z0-9+.-]*://[^/\\s:@]+:[^/\\s:@]+@",
      "ignoreCase": false
    },
    {
      "name": "pem",
      "kind": "pem",
      "pattern": "-----BEGIN ([A-Z0-9 ]*PRIVATE KEY)-----",
      "ignoreCase": false
    },
    {
      "name": "jwt",
      "kind": "jwt",
      "pattern": "[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
      "ignoreCase": false
    },
    {
      "name": "base64",
      "kind": "base64",
      "pattern": "[A-Za-z0-9+_-]{27,}={0,2}",
      "ignoreCase": false
    }
  ],
  "exemptEvidenceToken": {
    "pattern": "(?<!sha256:)\\b(?:[0-9a-f]{64}|[0-9a-f]{40}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\\b",
    "ignoreCase": true
  },
  "base64MinBytes": 20
}
