{
  // The dead-code pass: production sources only, in-file use counts as use.
  // Entries must match knip.jsonc; a mismatch surfaces as a new finding in the other pass.
  "$schema": "https://unpkg.com/knip@6.36.0/schema.json",
  // Workflow entries are not production entries and shadow ! entries for the same files.
  "github-actions": false,
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  // shared/record/drizzle.config.ts loads every exported table from these files.
  "ignoreIssues": {
    "shared/record/schema.ts": ["exports", "types"],
    "shared/record/schema-auth.ts": ["exports", "types"],
    "shared/record/schema-run.ts": ["exports", "types"],
    "shared/record/schema-review.ts": ["exports", "types"],
    "shared/record/schema-landing.ts": ["exports", "types"],
    "shared/record/schema-docs.ts": ["exports", "types"],
    "shared/record/schema-subjects.ts": ["exports", "types"],
    "shared/record/schema-hub.ts": ["exports", "types"],
    "shared/record/schema-snapshots.ts": ["exports", "types"],
    // Cross-concern session API includes clear before its sign-out caller lands.
    "shared/record-session.ts": ["exports"],
    // Lazy-required from transport.ts; knip does not follow that require as export use.
    "orchestrator/src/transport/ajv-validator.ts": ["exports"],
    // rehearse.sh's eval imports the export.
    "orchestrator/src/postgres/migration-failure.ts": ["exports"],
    "orchestrator/src/postgres/migration-notices.ts": ["exports"],
    // Cloudflare loads this default export through wrangler.toml rather than an import.
    "hub/deploy/site/src/worker.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        // Loaded as schema entries by shared/record/drizzle.config.ts.
        "shared/record/schema.ts!",
        "shared/record/schema-auth.ts!",
        "shared/record/schema-run.ts!",
        "shared/record/schema-review.ts!",
        "shared/record/schema-landing.ts!",
        "shared/record/schema-docs.ts!",
        "shared/record/schema-subjects.ts!",
        "shared/record/schema-hub.ts!",
        "shared/record/schema-snapshots.ts!",
        ".githooks/*!",
        "bin/{bottega,hub,orch,retrieval-search}!",
        "hub/bin/*.sh!",
        "local-stack/bin/*.sh!",
        "ops/install.sh!",
        "ops/bin/*.sh!",
        "cli/bottega.ts!",
        "scripts/{build-binary,build-release-artifacts,publish-release,read-hosted-migrate-url,smoke-binary,smoke-release}.ts!",
        "scripts/check.ts!",
        "scripts/check-*.ts!",
        "scripts/record-migration-set.ts!",
        "scripts/record-rehearse.ts!",
        "scripts/affected-tests.ts!",
        "scripts/audit-hot-store-statements.ts!",
        "scripts/test-focused.ts!",
        "!scripts/**/*.fixtures.ts",
        "!scripts/**/*.test.ts",
        "!scripts/check-outcome.ts",
        "!scripts/check-plan.ts",
        "!scripts/remaining-report.ts",
        "!scripts/check-runtime.ts",
        "scripts/generate-recipe-schema.ts!",
        "scripts/reference.ts!",
        "scripts/quality/check-test-substance.ts!"
      ],
      "project": [
        "scripts/**/*.ts!",
        "!scripts/**/*.fixtures.ts",
        "!scripts/**/*.test.ts",
        "!scripts/test-preload.ts",
        "!scripts/quality/test-timing-decision.ts",
        "shared/**/*.ts!",
        "!shared/**/*.test.ts",
        "!shared/**/*.fixtures.ts",
        "!shared/test-*.ts",
        "scripts/architecture.ts!"
      ],
      "drizzle": { "config": ["shared/record/drizzle.config.ts"] },
      // Invoked through node_modules/.bin/depcruise in scripts/architecture-cruise.ts.
      "ignoreDependencies": ["dependency-cruiser"]
    },
    "cli": {
      "entry": ["bottega.ts!"],
      "project": ["**/*.ts!", "!**/*.test.ts"]
    },
    "orchestrator": {
      "entry": [
        "hooks/*!",
        "src/cli/orch.ts!",
        "src/record/record-api-server.ts!",
        // Spawned by path from src/run/run-dispatch.ts as the detached worker entry.
        "src/run/exec.ts!",
        "src/check/check-strict-schema.ts!",
        "test/run-gate.ts!",
        // Launched by path from src/sandbox/sandbox.ts for Grok's MCP configuration.
        "src/ask/ask-proxy.ts!",
        "scripts/acp-parity.ts!",
        "scripts/check-canon-lint.ts!",
        "scripts/check-pack-budget.ts!",
        "scripts/check-projects.ts!",
        "scripts/import-postgres-projects.ts!",
        // Imported by the inline eval in deploy/backup/rehearse.sh.
        "src/postgres/migration-failure.ts!",
        "src/postgres/migration-notices.ts!",
        "scripts/test-postgres-rls.ts!"
      ],
      "project": [
        "src/**/*.ts!",
        "!src/**/*.test.ts",
        "!src/**/*.fixture*.ts",
        "!src/gate-load.ts",
        "scripts/**/*.ts!",
        "!scripts/**/*.test.ts",
        "!test/**/*.ts"
      ],
      "ignoreDependencies": [
        // Invoked through node_modules/.bin/codex-acp in src/transport/transport.ts.
        "@agentclientprotocol/codex-acp"
      ]
    },
    "hub": {
      "entry": ["src/cli.ts!", "src/hosted.ts!"],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts", "!src/**/*.fixture*.ts", "!test/**/*.ts"]
    },
    "hub/data": {
      "project": ["src/**/*.ts!", "!src/**/*.test.ts", "!test/**/*.ts"]
    },
    "hub/ui": {
      "entry": [".storybook/preview.css!"]
    },
    "hub/views": {
      "entry": [".storybook/preview.css!"],
      // Vite resolves codemirror-lang-mermaid's undeclared import through hub/web's alias.
      "ignoreDependencies": ["@lezer/common"]
    },
    "hub/site": {
      "project": ["src/**/*.{ts,tsx}!", "!src/**/*.test.{ts,tsx}"]
    },
    "retrieval": {
      "entry": ["src/benchmark/benchmark.ts!", "src/search-cli.ts!"],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts"]
    },
    "hub/web": {
      "entry": ["src/main.tsx!"],
      "project": ["src/**/*.{ts,tsx}!", "vite.config.ts!"],
      // Loaded through the CSS import in src/app/globals.css.
      "ignoreDependencies": ["tailwindcss"]
    },
    "hub/deploy/site": {
      "entry": ["src/worker.ts!"],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts"]
    }
  }
}
