node_modules
.DS_Store

*.pyc
__pycache__/
.venv/

*.log

# Operator-specific MCP servers are configured per checkout.
.mcp.json

# per-directory Claude state, not shared.
# settings.json and the port-feature skill shim are project config and must
# be tracked; everything else under .claude/ (worktrees, local settings) is not.
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/port-feature/
.claude/skills/port-feature/*
!.claude/skills/port-feature/SKILL.md
# A pattern with a slash is anchored, so the rules above reach only the
# repository root. Local settings appear under any concern's .claude/ too.
**/.claude/settings.local.json

# Bun installs workspace dependencies locally from the tracked root lockfile.
orchestrator/node_modules
orchestrator/bun.lock
hub/node_modules
hub/bun.lock
hub/web/dist/
hub/web/node_modules
hub/web/bun.lock

# Screenshots and page snapshots taken while checking the dashboard by eye.
# Working material, not the deliverable.
.playwright-mcp/
hub-*.png
/tmp-shots/
