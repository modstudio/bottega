#!/bin/sh

script_path=$(readlink -f "$0" 2>/dev/null || echo "$0")
root=$(dirname "$script_path")/..

binary=$BOTTEGA_CLI_BINARY
stamp=$binary.stamp

stamp_size=
stamp_mtime=
stamp_inode=
if test -n "$binary" && test -f "$stamp"; then
  while IFS='=' read -r stamp_key stamp_value; do
    case "$stamp_key" in
      size) stamp_size=$stamp_value ;;
      mtime) stamp_mtime=$stamp_value ;;
      inode) stamp_inode=$stamp_value ;;
    esac
  done < "$stamp"
  kernel=$(uname 2>/dev/null) || kernel=
  case "$kernel" in
    Darwin) binary_stat=$(stat -f '%z %m %i' "$binary" 2>/dev/null) || binary_stat= ;;
    Linux) binary_stat=$(stat -c '%s %Y %i' "$binary" 2>/dev/null) || binary_stat= ;;
    *) binary_stat= ;;
  esac
  binary_size=${binary_stat%% *}
  binary_stat_rest=${binary_stat#* }
  binary_mtime=${binary_stat_rest%% *}
  binary_inode=${binary_stat_rest#* }
  if test -n "$stamp_size" && test "$binary_size" = "$stamp_size" &&
    test -n "$stamp_mtime" && test "$binary_mtime" = "$stamp_mtime" &&
    test -n "$stamp_inode" && test "$binary_inode" = "$stamp_inode"; then
    export BOTTEGA_CHECKOUT_ROOT="$root"
    exec "$binary" "$@"
  fi
fi

exec bun --no-env-file "$root/cli/bottega.ts" "$@"
