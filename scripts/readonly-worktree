#!/bin/sh
# bottega's worktree.readonly_create: a detached tree for a read-only worker,
# with the main checkout's vendor directories linked in.
#
# Why linked rather than installed: the codex sandbox cannot write bun's
# tempdir, so `bun install` inside the tree fails with PermissionDenied (lens
# runs 2242 and 2244, 2026-09-06). The vendor tree therefore has to exist
# before the sandbox starts, and a read-only worker never needs its own copy.
#
# Why a real directory of links rather than one symlink: the ignore pattern is
# `node_modules/`, which matches a directory and not a symlink, so a symlinked
# node_modules shows up as untracked and fails the post-create check (runs
# 2254-2256). A real directory whose entries are links is ignored as a whole.
# Usage: scripts/readonly-worktree <path> <base>   (cwd: the main checkout)
set -eu
path=$1
base=$2
root=$(git rev-parse --show-toplevel)
git worktree add --detach "$path" "$base" >/dev/null
for dir in . orchestrator hub hub/web; do
  source="$root/$dir/node_modules"
  target="$path/$dir/node_modules"
  if [ -d "$source" ] && [ -d "$path/$dir" ] && [ ! -e "$target" ]; then
    mkdir "$target"
    for entry in "$source"/* "$source"/.[!.]*; do
      [ -e "$entry" ] || continue
      ln -s "$entry" "$target/$(basename "$entry")"
    done
  fi
done
printf '%s\n' "$path"
