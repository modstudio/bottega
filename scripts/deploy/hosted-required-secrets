#!/usr/bin/env bash
# Required deployed secret names and the legacy secret whose owner supplies each value.
# shellcheck disable=SC2034 # This file is sourced by hosted; its declarations are its interface.

declare -ar HOSTED_API_REQUIRED_SECRETS=(
  BOTTEGA_RECORD_URL
)

declare -ar HOSTED_HUB_REQUIRED_SECRETS=(
  BOTTEGA_RECORD_API_URL
  BOTTEGA_RECORD_DATABASE_URL
)

hosted_app_identity() {
  local app="${1:-}"
  local usage_script="${0#./}"

  case "$app" in
    api)
      fly_app="bottega-api"
      required_secrets=("${HOSTED_API_REQUIRED_SECRETS[@]}")
      ;;
    hub)
      fly_app="bottega-hub"
      required_secrets=("${HOSTED_HUB_REQUIRED_SECRETS[@]}")
      ;;
    *)
      echo "REFUSE: expected api or hub; use $usage_script <api|hub>" >&2
      return 1
      ;;
  esac

  if (( $# != 1 )); then
    echo "REFUSE: expected exactly one app; use $usage_script <api|hub>" >&2
    return 1
  fi
}
