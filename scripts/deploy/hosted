#!/usr/bin/env bash
# Migrate the hosted record, confirm the image's schema, and deploy one public app.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"
APP="${1:-}"

case "$APP" in
  api|hub) ;;
  *)
    echo "REFUSE: expected api or hub; use scripts/deploy/hosted <api|hub>" >&2
    exit 1
    ;;
esac

if (( $# != 1 )); then
  echo "REFUSE: expected exactly one app; use scripts/deploy/hosted <api|hub>" >&2
  exit 1
fi

release_command="bottega release run bottega --rung hosted-$APP"
for release_variable in ORCH_RELEASE_PROJECT ORCH_RELEASE_RUNG ORCH_RELEASE_COMMIT; do
  if [[ -z "${!release_variable:-}" ]]; then
    echo "REFUSE: $release_variable is unset or empty; deploy with $release_command" >&2
    exit 1
  fi
done
if [[ "$ORCH_RELEASE_PROJECT" != "bottega" ]]; then
  echo "REFUSE: ORCH_RELEASE_PROJECT must be bottega; deploy with $release_command" >&2
  exit 1
fi
if [[ "$ORCH_RELEASE_RUNG" != "hosted-$APP" ]]; then
  echo "REFUSE: ORCH_RELEASE_RUNG must be hosted-$APP for $APP; deploy with $release_command" >&2
  exit 1
fi

# Keep the credential out of shell traces whether it was inherited or read below,
# and out of the environment of every command that does not need it.
set +x
record_migrate_url="${ORCH_RECORD_MIGRATE_URL:-}"
unset ORCH_RECORD_MIGRATE_URL

commit="$(git -C "$PROJECT_ROOT" rev-parse HEAD)"
if [[ "$ORCH_RELEASE_COMMIT" != "$commit" ]]; then
  echo "REFUSE: ORCH_RELEASE_COMMIT does not match checkout commit $commit; deploy with $release_command" >&2
  exit 1
fi
if [[ -n "$(git -C "$PROJECT_ROOT" status --porcelain --untracked-files=no)" ]]; then
  echo "REFUSE: tracked files differ from the commit being deployed; commit or stash them, then release with bottega release run" >&2
  exit 1
fi

if [[ -z "$record_migrate_url" ]]; then
  if ! record_migrate_url="$(
    env -u ORCH_RECORD_MIGRATE_URL \
      bun --no-env-file "$PROJECT_ROOT/scripts/read-hosted-migrate-url.ts" 2>/dev/null
  )"; then
    echo "REFUSE: ORCH_RECORD_MIGRATE_URL is unset; its owner is ~/.claude/.env" >&2
    exit 1
  fi
fi

if ! command -v fly >/dev/null 2>&1; then
  echo "REFUSE: fly is unavailable; install or expose the Fly CLI before deploying" >&2
  exit 1
fi

cd "$PROJECT_ROOT"

if ! ORCH_RECORD_MIGRATE_URL="$record_migrate_url" "$PROJECT_ROOT/bin/bottega" record migrate; then
  echo "REFUSE: record migration or applied-equals-shipped confirmation failed; fly deploy was not run" >&2
  exit 1
fi

if [[ "$APP" == "api" ]]; then
  exec env -u ORCH_RECORD_MIGRATE_URL fly deploy --config "$PROJECT_ROOT/orchestrator/deploy/api/fly.toml" \
    --build-arg GIT_SHA="$commit"
fi

exec env -u ORCH_RECORD_MIGRATE_URL fly deploy --config "$PROJECT_ROOT/hub/deploy/fly.toml" \
  --build-arg VITE_HUB_MODE=hosted \
  --build-arg VITE_RECORD_API_URL=https://api.bottega.run \
  --build-arg VITE_PUBLIC_SITE_ORIGIN=https://bottega.run \
  --build-arg VITE_APP_ORIGIN=https://app.bottega.run \
  --build-arg GIT_SHA="$commit"
